# Access Control Service - variables de entorno (copia este archivo a .env; nunca subas .env al repositorio)
# Puerto HTTP
PORT=3006
# Conexión a PostgreSQL
DATABASE_URL=postgresql://cowork:cowork@localhost:5432/coworkspace
# Schema propio del servicio (base de datos por servicio)
DB_SCHEMA=access
# Redis (eventos de dominio)
REDIS_URL=redis://localhost:6379
# Clave compartida con el Gateway; sin ella el servicio rechaza llamadas directas
INTERNAL_API_KEY=cambia-esta-clave
# Nombre del servicio en eventos y logs
SERVICE_NAME=access-control-service
# Consulta síncrona de la membresía
MEMBERSHIP_SERVICE_URL=http://localhost:3001
# Vida del QR en segundos
ACCESS_QR_TTL_SECONDS=120
# Vida de una tarjeta NFC en días
ACCESS_NFC_TTL_DAYS=30
# Tiempo máximo de la consulta a Membership
MEMBERSHIP_TIMEOUT_MS=45000
