# Membership Service - variables de entorno (copia este archivo a .env; nunca subas .env al repositorio)
# Puerto HTTP
PORT=3001
# Conexión a PostgreSQL
DATABASE_URL=postgresql://cowork:cowork@localhost:5432/coworkspace
# Schema propio del servicio (base de datos por servicio)
DB_SCHEMA=membership
# Redis (eventos de dominio)
REDIS_URL=redis://localhost:6379
# Clave compartida con el Gateway; sin ella el servicio rechaza llamadas directas
INTERNAL_API_KEY=cambia-esta-clave
# Nombre del servicio en eventos y logs
SERVICE_NAME=membership-service
# Firma de los JWT (la misma del Gateway)
JWT_SECRET=cambia-este-secreto
# Duración del token de acceso
ACCESS_TOKEN_TTL=15m
# Días de vigencia del refresh token
REFRESH_TOKEN_TTL_DAYS=7
# Duración del periodo de la membresía
BILLING_CYCLE_DAYS=30
# Administrador que se crea al iniciar (opcional)
ADMIN_EMAIL=admin@coworkspace.co
# Contraseña de ese administrador
ADMIN_PASSWORD=cambia-esta-clave
