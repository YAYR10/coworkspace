# Booking Service - variables de entorno (copia este archivo a .env; nunca subas .env al repositorio)
# Puerto HTTP
PORT=3003
# Conexión a PostgreSQL
DATABASE_URL=postgresql://cowork:cowork@localhost:5432/coworkspace
# Schema propio del servicio (base de datos por servicio)
DB_SCHEMA=booking
# Redis (eventos de dominio)
REDIS_URL=redis://localhost:6379
# Clave compartida con el Gateway; sin ella el servicio rechaza llamadas directas
INTERNAL_API_KEY=cambia-esta-clave
# Nombre del servicio en eventos y logs
SERVICE_NAME=booking-service
# URL del Space Service
SPACE_SERVICE_URL=http://localhost:3002
# Tiempo máximo de cada consulta a Space
SPACE_TIMEOUT_MS=60000
# Minutos para completar el cobro antes de liberar el horario
SAGA_TIMEOUT_MINUTES=20
# Duración máxima de una reserva
MAX_BOOKING_HOURS=12
# Reintentos del bloqueo optimista
OPTIMISTIC_LOCK_MAX_RETRIES=5
# Tiempo total de reintentos mientras Space despierta (opcional)
SPACE_RETRY_BUDGET_MS=45000
