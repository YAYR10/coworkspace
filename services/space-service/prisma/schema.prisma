generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id          String   @id @default(uuid())
  name        String
  country     String   @default("Colombia")
  city        String
  address     String
  description String?
  /// Servicios de la sede publicados por el coordinador: WiFi, café, parqueadero...
  services    String[] @default([])
  /// Una sede sin publicar solo la ven coordinadores y administradores
  isPublished Boolean  @default(true) @map("is_published")
  /// Foto subida (/api/locations/:id/photo) o URL externa
  photoUrl    String?  @map("photo_url")
  /// Coordenadas para el mapa de sedes
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now()) @map("created_at")
  rooms       Room[]
  desks       Desk[]
  photo       LocationPhoto?

  @@index([country, city])
  @@index([city])
  @@map("locations")
}

model Room {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  name       String
  capacity   Int
  /// Ej: { "projector": true, "whiteboard": true, "tv": false }
  equipment  Json     @default("{}")
  isActive   Boolean  @default(true) @map("is_active")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@map("rooms")
}

model Desk {
  id          String   @id @default(uuid())
  locationId  String   @map("location_id")
  code        String
  isDedicated Boolean  @default(false) @map("is_dedicated")
  isActive    Boolean  @default(true) @map("is_active")
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, code])
  @@map("desks")
}

/// Foto de la sede guardada en PostgreSQL (el disco de Render free es efímero).
/// Se redimensiona en el navegador antes de subirla (máx. ~1 MB).
model LocationPhoto {
  locationId String   @id @map("location_id")
  mime       String
  data       Bytes
  updatedAt  DateTime @updatedAt @map("updated_at")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("location_photos")
}
