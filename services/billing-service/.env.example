# Billing Service - variables de entorno (copia este archivo a .env; nunca subas .env al repositorio)
# Puerto HTTP
PORT=3004
# Conexión a PostgreSQL
DATABASE_URL=postgresql://cowork:cowork@localhost:5432/coworkspace
# Schema propio del servicio (base de datos por servicio)
DB_SCHEMA=billing
# Redis (eventos de dominio)
REDIS_URL=redis://localhost:6379
# Clave compartida con el Gateway; sin ella el servicio rechaza llamadas directas
INTERNAL_API_KEY=cambia-esta-clave
# Nombre del servicio en eventos y logs
SERVICE_NAME=billing-service
# Tarifa por hora de sala fuera del plan (COP)
EXTRA_ROOM_HOURLY_RATE=50000
# Tarifa por hora de puesto fuera del plan (COP)
EXTRA_DESK_HOURLY_RATE=15000
# Cupo de la pasarela simulada
EXTRA_CHARGE_APPROVAL_LIMIT=200000
# Forzar rechazo en la pasarela simulada (pruebas)
PAYMENT_FORCE_REJECT=false
# Llave pública de Wompi (pub_test_… en sandbox)
WOMPI_PUBLIC_KEY=
# Secreto de integridad para firmar el checkout
WOMPI_INTEGRITY_SECRET=
# Secreto de eventos para validar el webhook
WOMPI_EVENTS_SECRET=
# API de Wompi (por defecto sandbox o producción según la llave)
WOMPI_API_URL=
# Página a la que vuelve el checkout
PAYMENT_REDIRECT_URL=http://localhost:5173/pago
# Tiempo máximo de la llamada a Membership (opcional)
MEMBERSHIP_TIMEOUT_MS=60000
