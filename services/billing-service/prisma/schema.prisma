generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanStatus {
  ACTIVE
  EXPIRED
}

enum InvoiceStatus {
  PAID
  FAILED
}

/// PENDING: esperando el pago en la pasarela (Wompi)
enum ChargeStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
}

/// Proyección local del plan vigente de cada miembro (se alimenta de eventos de Membership)
model MemberPlan {
  memberId       String     @id @map("member_id")
  subscriptionId String     @map("subscription_id")
  planCode       String     @map("plan_code")
  planName       String     @map("plan_name")
  price          Int
  resourceAccess String[]   @map("resource_access")
  status         PlanStatus
  renewsAt       DateTime   @map("renews_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("member_plans")
}

model Invoice {
  id               String        @id @default(uuid())
  memberId         String        @map("member_id")
  subscriptionId   String        @map("subscription_id")
  period           String
  amount           Int
  status           InvoiceStatus
  electronicNumber String?       @unique @map("electronic_number")
  failureReason    String?       @map("failure_reason")
  createdAt        DateTime      @default(now()) @map("created_at")

  @@unique([subscriptionId, period])
  @@index([memberId])
  @@map("invoices")
}

model ExtraCharge {
  id            String       @id @default(uuid())
  memberId      String       @map("member_id")
  bookingId     String       @unique @map("booking_id")
  amount        Int
  reason        String
  status        ChargeStatus
  failureReason String?      @map("failure_reason")
  /// Referencia enviada a la pasarela (<id del cargo>.<intento>)
  paymentReference String?   @map("payment_reference")
  /// Id de la transacción en Wompi
  transactionId String?      @map("transaction_id")
  paymentMethod String?      @map("payment_method")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([memberId])
  @@map("extra_charges")
}
