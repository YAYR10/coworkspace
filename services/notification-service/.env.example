# Notification Service - variables de entorno (copia este archivo a .env; nunca subas .env al repositorio)
# Puerto HTTP
PORT=3005
# Conexión a PostgreSQL
DATABASE_URL=postgresql://cowork:cowork@localhost:5432/coworkspace
# Schema propio del servicio (base de datos por servicio)
DB_SCHEMA=notification
# Redis (eventos de dominio)
REDIS_URL=redis://localhost:6379
# Clave compartida con el Gateway; sin ella el servicio rechaza llamadas directas
INTERNAL_API_KEY=cambia-esta-clave
# Nombre del servicio en eventos y logs
SERVICE_NAME=notification-service
# Para obtener nombre y correo del miembro
MEMBERSHIP_SERVICE_URL=http://localhost:3001
# Para el nombre del espacio y la sede
SPACE_SERVICE_URL=http://localhost:3002
# Clave de Brevo; vacío = modo demostración
BREVO_API_KEY=
# Remitente verificado en Brevo
MAIL_FROM=
# Nombre del remitente
MAIL_FROM_NAME=CoworkSpace
# Enlace del botón de los correos
APP_URL=http://localhost:5173
# Zona horaria de los correos
APP_TIMEZONE=America/Bogota
# Minutos antes de la reserva para el recordatorio
REMINDER_MINUTES_BEFORE=60
# Días antes del vencimiento para el aviso
MEMBERSHIP_WARNING_DAYS=3
