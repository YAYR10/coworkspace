# API Gateway - variables de entorno (copia este archivo a .env; nunca subas .env al repositorio)
# Puerto HTTP
PORT=3000
# Firma de los JWT (la misma del Membership Service)
JWT_SECRET=cambia-este-secreto
# Clave que el Gateway agrega a cada llamada; los microservicios rechazan las que no la traen
INTERNAL_API_KEY=cambia-esta-clave
# Solicitudes por minuto por IP (general y en /api/auth/login)
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Tiempo máximo de espera a un microservicio
PROXY_TIMEOUT_MS=60000
# Origen permitido del frontend (CORS)
CORS_ORIGIN=http://localhost:5173
# URL de cada microservicio
MEMBERSHIP_SERVICE_URL=http://localhost:3001
SPACE_SERVICE_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3003
BILLING_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
ACCESS_SERVICE_URL=http://localhost:3006
COMMUNITY_SERVICE_URL=http://localhost:3007
ANALYTICS_SERVICE_URL=http://localhost:3008
# Tiempo máximo que /health/services espera a un servicio dormido (opcional)
HEALTH_WAKE_BUDGET_MS=25000
