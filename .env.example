# Analytics Service - variables de entorno (copia este archivo a .env; nunca subas .env al repositorio)
# Puerto HTTP
PORT=3008
# Conexión a PostgreSQL
DATABASE_URL=postgresql://cowork:cowork@localhost:5432/coworkspace
# Schema propio del servicio (base de datos por servicio)
DB_SCHEMA=analytics
# Redis (eventos de dominio)
REDIS_URL=redis://localhost:6379
# Clave compartida con el Gateway; sin ella el servicio rechaza llamadas directas
INTERNAL_API_KEY=cambia-esta-clave
# Nombre del servicio en eventos y logs
SERVICE_NAME=analytics-service
# Réplica de solo lectura de las bases de los demás servicios
SOURCE_DATABASE_URL=postgresql://cowork:cowork@localhost:5432/coworkspace
# Frecuencia del ETL (cron con segundos)
ANALYTICS_ETL_CRON=0 */30 * * * *
# Días de reservas que procesa el ETL
ANALYTICS_WINDOW_DAYS=90
# Zona horaria de las franjas
ANALYTICS_TZ=America/Bogota
# Horas de operación por día (denominador de la ocupación)
ANALYTICS_OPEN_HOURS=14
# Schema de origen de Membership (opcional)
SOURCE_SCHEMA_MEMBERSHIP=membership
# Schema de origen de Space (opcional)
SOURCE_SCHEMA_SPACE=space
# Schema de origen de Booking (opcional)
SOURCE_SCHEMA_BOOKING=booking
# Schema de origen de Billing (opcional)
SOURCE_SCHEMA_BILLING=billing
